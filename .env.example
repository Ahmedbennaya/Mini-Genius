ADMIN_EMAIL=admin@minigenius.tn
ADMIN_PASSWORD=change-this-password
NEXT_PUBLIC_SITE_URL=https://mini-genius-chi.vercel.app

# Meta Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=2015145739108049
NEXT_PUBLIC_META_CURRENCY=TND
META_PIXEL_ID=2015145739108049
META_CURRENCY=TND
META_CUSTOMER_COUNTRY=tn
# SECURITY: never commit a real token. Set the real value in Vercel env vars only.
META_CONVERSIONS_ACCESS_TOKEN=your-meta-conversions-api-token
META_CONVERSIONS_API_VERSION=v25.0
# Optional: paste a Meta Events Manager test code while testing, then remove it.
META_CONVERSIONS_TEST_EVENT_CODE=

# Analytics & tracking (all optional — a platform only loads when its ID is set)
# Prefer GTM as the single container; or set GA4 directly. Don't set both GA4 in
# GTM and NEXT_PUBLIC_GA4_ID, or events would be counted twice.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
# Consent model: "granted" = opt-out banner (default), "denied" = opt-in (EU/GDPR)
NEXT_PUBLIC_CONSENT_DEFAULT=granted

# Production order storage on Vercel:
# Connect a Vercel KV / Upstash Redis database and copy these env vars.
KV_REST_API_URL=
KV_REST_API_TOKEN=
ORDERS_STORAGE_KEY=mini-genius:orders
